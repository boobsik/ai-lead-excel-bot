# Telegram
BOT_TOKEN=123456789:AAH-your-token-from-botfather
ADMIN_ID=123456789

# AI-анализ (OpenAI-совместимый API).
# Оставьте LLM_API_KEY пустым, чтобы работал локальный fallback-парсер.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Необязательно: прокси только для Telegram API.
# Примеры: http://127.0.0.1:10808 или socks5://127.0.0.1:1080
PROXY_URL=

# Необязательные настройки
# DB_PATH=leads.db
# LLM_TIMEOUT=25
